{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/edit-context.sh 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "income rules"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-state.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
