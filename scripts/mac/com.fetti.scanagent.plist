<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fetti.scanagent</string>
  <key>ProgramArguments</key>
  <array><string>/Users/fetti/bin/fetti-scan-agent</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/fetti/Library/Logs/fetti-scan-agent.log</string>
  <key>StandardErrorPath</key><string>/Users/fetti/Library/Logs/fetti-scan-agent.log</string>
</dict>
</plist>
