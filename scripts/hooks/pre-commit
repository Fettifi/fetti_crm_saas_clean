#!/bin/sh
# INCOME GUARD — runs before every commit that touches the income engine.
#
# WHY THIS EXISTS. Ramon, 2026-08-01: "You're supposed to be getting smarter and learning with
# every pass because all this stuff is supposed to be stored in your memory, but you often
# forget and don't seem to be checking your streams before making decisions."
#
# He is right, and a written lesson does not fix it. On 2026-08-01 a memory that said "test the
# WIRING not the label" was already on file when a constant named MAX_DOCS = 8 was read,
# believed, and used to justify a change that re-rolled a settled $11,701 income to $3,129 on a
# live client file. The note existed. It was not consulted at the moment of the decision.
#
# So the rule stops depending on anyone remembering it. This hook runs whether the committer is
# a fresh session that has never heard of the Wilson file, another agent, or a human at a
# terminal. Prose reminds; a gate refuses.
#
# Escape hatch when you genuinely need it:  git commit --no-verify

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$CHANGED" ] && exit 0

# Only the paths that can move a borrower's qualifying income.
INCOV=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/income.ts' -e 'lib/incomePdf' -e 'app/income/' -e 'IncomeQualifier' -e 'scripts/verify-income-overrides')
WATCHED=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/income/' -e 'verify-income' -e 'scripts/verify-employer-merge' -e 'scripts/verify-benefit-deposits' -e 'scripts/verify-income-stability')
# The auth gate is a separate, cheaper concern: proxy.ts requires every protected API to be
# listed in TWO places, and forgetting the second leaves the route fully public. Milliseconds.
AUTH=$(printf '%s\n' "$CHANGED" | grep -F -e 'proxy.ts' -e 'scripts/verify-auth-gate')
# What leaves the building for a wholesale lender. An unlabelled AVM in a MISMO file is a
# representation about a property that nobody at Fetti actually made.
DOCS=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/scenario' -e 'app/api/scenarios' -e 'lib/comparePdf' -e 'lib/compareTypes' -e 'scripts/verify-scenario' -e 'scripts/verify-compare' -e 'lib/preapprovalPdf' -e 'app/api/preapprovals' -e 'scripts/verify-preapproval' -e 'lib/scenarioStore' -e 'lib/compare.ts' -e 'scripts/verify-blob-stores')
AVM=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/mismo' -e 'lib/urla.ts' -e 'underwriter-desk' -e 'lib/underwritingDesk' -e 'scripts/verify-avm' -e 'scripts/verify-senior-lien' -e 'scripts/verify-dscr-senior')
# The pricer produces a BORROWER-FACING dollar figure. Its own failure shape is already on
# record: the PDF route accepted originationPct from the screen and never passed it to the
# engine, so the advisor saw one number and the borrower was handed another. Offline and
# deterministic, so it costs nothing to make it unforgettable.
PRICER=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/closingCosts' -e 'lib/pricerPdf' -e 'app/api/pricer/' -e 'scripts/verify-pricer')
# lib/pricer.ts owns PITIA and mortgage insurance — the file where a VA borrower was being
# quoted MI that does not exist on a VA loan.
MI=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/pricer.ts' -e 'lib/underwritingDesk' -e 'scripts/verify-mi' -e 'scripts/verify-financed-fee')
# The portfolio grid's per-property actuals: an editor that stops short of the roll-up looks
# fixed and is not.
UW=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/underwrite/' -e 'UnderwriterApp' -e 'scripts/verify-underwrite' -e 'deal-analyzer' -e 'scripts/verify-deal-analyzer')
SSN=$(printf '%s\n' "$CHANGED" | grep -F -e 'los/extract' -e '1003/page' -e 'lib/urla.ts' -e 'scripts/verify-ssn-merge')
PA=$(printf '%s\n' "$CHANGED" | grep -F -e 'preapproval' -e 'letter/' -e 'preapprovals')
# WHOSE LICENCE PRINTS UNDER THE SIGNATURE. Fetti has two NMLS ids — the LLC's (2267023) and
# Ramon's own (2235992) — and the pre-approval letter prints both, in different slots. The
# letter's officer field defaulted to the COMPANY id in two independent places, so letters sent
# to listing agents named the wrong licensee in the field reserved for the individual
# originator. It is a correct-LOOKING value: 2267023 is a real Fetti licence that belongs in ~30
# other places in this repo, so nothing about reading the code tells you it is wrong here.
# Scoped wider than $PA because brand.ts, urla.ts and the pricer sheet all carry an id too.
NMLS=$(printf '%s\n' "$CHANGED" | grep -F -e 'officerIdentity' -e 'lib/brand.ts' -e 'lib/urla.ts' -e 'preapproval' -e 'letter/' -e 'pricerPdf' -e 'verify-officer-nmls')
DOC=$(printf '%s\n' "$CHANGED" | grep -F -e 'docContent' -e 'credit-liabilities' -e 'files/[id]/docs' -e 'verify-doc-detection' -e 'verify-income' -e 'IncomeQualifier')
# WHO IS A REAL PERSON. The Shield verdict now decides whether a lead is nurtured at all, so a
# band written wrongly either silences a borrower or clears a bot. On 2026-08-02 a backfill
# wrote a verdict outside the declared union on 190 rows, collapsed the whole "watch" tier into
# "clean", and split one fact across two spellings that two different readers each read one of.
SHIELD=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/leadShield' -e 'lib/leadReality' -e 'shield-sweep' -e 'lib/notify/leadDigest' -e 'scripts/shield-' -e 'scripts/verify-shield')
# THE GUARDS THEMSELVES. Ramon, 2026-08-04: "No longer make assumption or assertions ever.
# Validate and verify every decision, every action so that they make sense." Said after the
# SEVENTH assertion in one day printed "ok" while checking nothing — one matched an import line,
# one a dependency array, one had its arguments reversed so a message string served as the
# condition. Nine guards were also sitting in scripts/ with no npm entry at all: unrunnable.
# A guard that cannot fail is worse than no guard, because it reports safety that is not there.
GUARDMETA=$(printf '%s\n' "$CHANGED" | grep -E 'scripts/verify-|scripts/hooks/pre-commit|^package\.json$')
# The DSCR lease-rent engine and the LTV basis both produce numbers that leave the building.
RENT=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/income/rentalIncome' -e 'lib/dscr' -e 'verify-rental-income')
LTV=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/scenario' -e 'verify-scenario-ltv')
BIZ=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/bizApp' -e 'verify-bizapp')
GOV=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/governor' -e 'lib/conversationGovernor' -e 'verify-governor')
# AN IMPORT THAT ONLY RESOLVES ON THIS MACHINE. On 2026-08-04 lib/officerIdentity.ts was never
# committed; three commits imported it. tsc passed, npm run build passed, every guard passed —
# all of them read the DISK. Vercel only has what git has, so every production build died at
# "Module not found" and three fixes reached nobody for hours. 0.6s, so it runs on any TS commit.
ANYTS=$(printf '%s\n' "$CHANGED" | grep -E '\.(ts|tsx)$')
CARD=$(printf '%s\n' "$CHANGED" | grep -F -e 'cardAuth' -e 'card-auth' -e 'CardAuthPanel' -e 'verify-card-auth')
PAYLOAD_PRE=$(printf '%s\n' "$CHANGED" | grep -E '^(app|components)/.*\.(ts|tsx)$')
[ -z "$WATCHED" ] && [ -z "$AUTH" ] && [ -z "$PRICER" ] && [ -z "$MI" ] && [ -z "$UW" ] && [ -z "$INCOV" ] && [ -z "$AVM" ] && [ -z "$DOCS" ] && [ -z "$SHIELD" ] && [ -z "$PAYLOAD_PRE" ] && [ -z "$NMLS" ] && [ -z "$GUARDMETA" ] && [ -z "$RENT" ] && [ -z "$LTV" ] && [ -z "$BIZ" ] && [ -z "$GOV" ] && [ -z "$ANYTS" ] && [ -z "$CARD" ] && exit 0

echo ""
echo "── repo guard ────────────────────────────────────────────────"
printf '%s\n' "$WATCHED" "$AUTH" "$PRICER" "$MI" "$UW" "$INCOV" "$AVM" "$DOCS" | grep -v '^$' | sed 's/^/   touched: /'
echo ""

FAILED=""

# Runs first alongside the guard-of-guards: a commit that cannot BUILD makes every check below
# it academic. Compares imports against `git ls-files`, which is the only thing on this machine
# that knows the difference between a file I have and a file I shipped.
if [ -n "$ANYTS" ]; then
  printf "   %-24s " "verify:tracked-imports"
  OUT=$(npm run --silent verify:tracked-imports 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:tracked-imports"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

# Runs FIRST: if the guards themselves are broken, every PASS printed below it is unreliable.
if [ -n "$GUARDMETA" ]; then
  printf "   %-24s " "verify:assertions"
  OUT=$(npm run --silent verify:assertions 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:assertions"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

for PAIR in "$CARD:verify:card-auth" "$RENT:verify:rental-income" "$LTV:verify:scenario-ltv" "$BIZ:verify:bizapp" "$GOV:verify:governor-rules"; do
  TRIG=${PAIR%%:*}; G=${PAIR#*:}
  [ -z "$TRIG" ] && continue
  printf "   %-24s " "$G"
  OUT=$(npm run --silent "$G" 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
done

if [ -n "$SHIELD" ]; then
  printf "   %-18s " "verify:shield-verdict"
  OUT=$(npm run --silent verify:shield-verdict 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:shield-verdict"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$AUTH" ]; then
  printf "   %-18s " "verify:auth"
  OUT=$(npm run --silent verify:auth 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:auth"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

# Any client screen or API route can introduce the sent-but-never-read divergence, so this one
# is keyed on the broad surface rather than a single feature.
NUMIN=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/numericInput' -e 'UnderwriterApp' -e 'app/income/' -e 'scripts/verify-numeric-input')
if [ -n "$NUMIN" ]; then
  printf "   %-18s " "verify:numeric-input"
  OUT=$(npm run --silent verify:numeric-input 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:numeric-input"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi
PAYLOAD=$(printf '%s\n' "$CHANGED" | grep -E '^(app|components)/.*\.(ts|tsx)$')
if [ -n "$PAYLOAD" ]; then
  printf "   %-18s " "verify:payloads"
  OUT=$(npm run --silent verify:payloads 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:payloads"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$DOCS" ]; then
  for G in verify:scenario verify:preapproval verify:compare-pdf verify:blob-stores; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | grep -v 'Warning\|fontkit' | sed 's/^/      /'
    fi
  done
fi

if [ -n "$AVM" ]; then
  for G in verify:avm verify:senior-lien verify:dscr-senior; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | sed 's/^/      /'
    fi
  done
fi

if [ -n "$INCOV" ]; then
  printf "   %-18s " "verify:income-override"
  OUT=$(npm run --silent verify:income-override 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:income-override"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$DOC" ]; then
  printf "   %-24s " "verify:doc-detection"
  OUT=$(npm run --silent verify:doc-detection 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:doc-detection"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$NMLS" ]; then
  printf "   %-24s " "verify:officer-nmls"
  OUT=$(npm run --silent verify:officer-nmls 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:officer-nmls"; printf '%s\n' "$OUT" | grep -v 'Warning\|fontkit' | sed 's/^/      /'
  fi
fi

if [ -n "$PA" ]; then
  for G in verify:preapproval verify:preapproval-fields verify:preapproval-from-calc; do
    printf "   %-24s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | sed 's/^/      /'
    fi
  done
fi

if [ -n "$SSN" ]; then
  printf "   %-18s " "verify:ssn-merge"
  OUT=$(npm run --silent verify:ssn-merge 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:ssn-merge"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$UW" ]; then
  for G in verify:underwrite verify:deal; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | sed 's/^/      /'
    fi
  done
fi

if [ -n "$MI" ]; then
  for G in verify:mi verify:financed-fee; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | sed 's/^/      /'
    fi
  done
fi

if [ -n "$PRICER" ]; then
  for G in verify:pricer verify:pricer-pdf; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | grep -v 'Warning\|fontkit' | sed 's/^/      /'
    fi
  done
fi

# Offline, deterministic, ZERO API calls. These always run.
[ -z "$WATCHED" ] && GUARDS="" || GUARDS="verify:employer verify:benefits"
for GUARD in $GUARDS; do
  printf "   %-18s " "$GUARD"
  OUT=$(npm run --silent "$GUARD" 2>&1)
  if [ $? -eq 0 ]; then
    echo "PASS"
  else
    echo "FAIL"
    FAILED="$FAILED $GUARD"
    printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
done

# Needs the database + .env.local. Skip cleanly where they are absent (CI, a fresh clone)
# rather than blocking a commit for a reason the committer cannot act on.
if [ -n "$WATCHED" ] && [ -f .env.local ]; then
  printf "   %-18s " "verify:income-replay"
  OUT=$(npm run --silent verify:income-replay 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:income-replay"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
  printf "   %-18s " "verify:income"
  OUT=$(npm run --silent verify:income 2>&1)
  if [ $? -eq 0 ]; then
    echo "PASS"
  else
    echo "FAIL"
    FAILED="$FAILED verify:income"
    printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
elif [ -n "$WATCHED" ]; then
  echo "   verify:income      SKIPPED (no .env.local — cannot reach the database)"
fi

if [ -n "$FAILED" ]; then
  # SELF-RECORDING. The block writes itself into the lesson ledger, scoped to the files that
  # were actually touched, so the next edit to any of them replays this failure. Nobody decides
  # to write it down; that decision is exactly what kept failing.
  for G in $FAILED; do
    printf '%s\n' "$WATCHED" | while read -r W; do
      [ -z "$W" ] && continue
      SCOPE=$(dirname "$W")
      "$REPO_ROOT/scripts/hooks/lessons.sh" record \
        --scope "$SCOPE" --kind "guard-block" \
        --summary "$G blocked a commit touching $SCOPE — a settled income number would have moved." \
        --detail "Run the guard and read what it names before editing here. If the change is intended: npm run verify:income -- --save" 2>/dev/null || true
    done
  done
  echo ""
  echo "   COMMIT BLOCKED —$FAILED"
  echo ""
  case "$FAILED" in
    *verify:officer-nmls*)
      echo "   Fetti has TWO NMLS ids and they are not interchangeable: #2267023 is the LLC's"
      echo "   (letterhead, licensing footer, advertising, brand artwork) and #2235992 is Ramon's"
      echo "   own (the 1003, the signature block on a letter he signs). A pre-approval prints"
      echo "   BOTH. The company id under \"Mortgage Loan Originator\" names the wrong licensee on"
      echo "   a document written to be forwarded to a listing agent. Read the failing check."
      ;;
  esac
  case "$FAILED" in
    *verify:auth*)
      echo "   verify:auth is NEVER a false alarm — a route in apiProtected but missing from"
      echo "   config.matcher is PUBLIC in production. Add the matcher entry named above."
      ;;
  esac
  case "$FAILED" in
    *verify:pricer*)
      echo "   A pricer failure means a manual figure no longer reaches the borrower's bottom"
      echo "   line, or the PDF no longer distinguishes a real quote from an estimate. Both are"
      echo "   how a good-faith estimate becomes a complaint. Read the named check."
      ;;
  esac
  case "$FAILED" in
    *verify:income*|*verify:employer*|*verify:benefits*)
      echo "   An income failure is not automatically a bug: adding a real income document SHOULD"
      echo "   change a file. The point is that it can never happen without somebody seeing it."
      echo "   If every income change listed above is intended, re-baseline and commit again:"
      echo "       npm run verify:income -- --save"
      ;;
  esac
  echo "   To bypass deliberately:  git commit --no-verify"
  echo "──────────────────────────────────────────────────────────────"
  exit 1
fi

echo "   all guards passed"
echo "──────────────────────────────────────────────────────────────"
exit 0
