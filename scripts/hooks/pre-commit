#!/bin/sh
# INCOME GUARD — runs before every commit that touches the income engine.
#
# WHY THIS EXISTS. Ramon, 2026-08-01: "You're supposed to be getting smarter and learning with
# every pass because all this stuff is supposed to be stored in your memory, but you often
# forget and don't seem to be checking your streams before making decisions."
#
# He is right, and a written lesson does not fix it. On 2026-08-01 a memory that said "test the
# WIRING not the label" was already on file when a constant named MAX_DOCS = 8 was read,
# believed, and used to justify a change that re-rolled a settled $11,701 income to $3,129 on a
# live client file. The note existed. It was not consulted at the moment of the decision.
#
# So the rule stops depending on anyone remembering it. This hook runs whether the committer is
# a fresh session that has never heard of the Wilson file, another agent, or a human at a
# terminal. Prose reminds; a gate refuses.
#
# Escape hatch when you genuinely need it:  git commit --no-verify

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$CHANGED" ] && exit 0

# Only the paths that can move a borrower's qualifying income.
WATCHED=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/income/' -e 'verify-income' -e 'scripts/verify-employer-merge' -e 'scripts/verify-benefit-deposits' -e 'scripts/verify-income-stability')
# The auth gate is a separate, cheaper concern: proxy.ts requires every protected API to be
# listed in TWO places, and forgetting the second leaves the route fully public. Milliseconds.
AUTH=$(printf '%s\n' "$CHANGED" | grep -F -e 'proxy.ts' -e 'scripts/verify-auth-gate')
# The pricer produces a BORROWER-FACING dollar figure. Its own failure shape is already on
# record: the PDF route accepted originationPct from the screen and never passed it to the
# engine, so the advisor saw one number and the borrower was handed another. Offline and
# deterministic, so it costs nothing to make it unforgettable.
PRICER=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/closingCosts' -e 'lib/pricerPdf' -e 'app/api/pricer/' -e 'scripts/verify-pricer')
# lib/pricer.ts owns PITIA and mortgage insurance — the file where a VA borrower was being
# quoted MI that does not exist on a VA loan.
MI=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/pricer.ts' -e 'lib/underwritingDesk' -e 'scripts/verify-mi')
# The portfolio grid's per-property actuals: an editor that stops short of the roll-up looks
# fixed and is not.
UW=$(printf '%s\n' "$CHANGED" | grep -F -e 'lib/underwrite/' -e 'UnderwriterApp' -e 'scripts/verify-underwrite')
PAYLOAD_PRE=$(printf '%s\n' "$CHANGED" | grep -E '^(app|components)/.*\.(ts|tsx)$')
[ -z "$WATCHED" ] && [ -z "$AUTH" ] && [ -z "$PRICER" ] && [ -z "$MI" ] && [ -z "$UW" ] && [ -z "$PAYLOAD_PRE" ] && exit 0

echo ""
echo "── repo guard ────────────────────────────────────────────────"
printf '%s\n' "$WATCHED" "$AUTH" "$PRICER" "$MI" "$UW" | grep -v '^$' | sed 's/^/   touched: /'
echo ""

FAILED=""

if [ -n "$AUTH" ]; then
  printf "   %-18s " "verify:auth"
  OUT=$(npm run --silent verify:auth 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:auth"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

# Any client screen or API route can introduce the sent-but-never-read divergence, so this one
# is keyed on the broad surface rather than a single feature.
PAYLOAD=$(printf '%s\n' "$CHANGED" | grep -E '^(app|components)/.*\.(ts|tsx)$')
if [ -n "$PAYLOAD" ]; then
  printf "   %-18s " "verify:payloads"
  OUT=$(npm run --silent verify:payloads 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:payloads"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$UW" ]; then
  printf "   %-18s " "verify:underwrite"
  OUT=$(npm run --silent verify:underwrite 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:underwrite"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$MI" ]; then
  printf "   %-18s " "verify:mi"
  OUT=$(npm run --silent verify:mi 2>&1)
  if [ $? -eq 0 ]; then echo "PASS"; else
    echo "FAIL"; FAILED="$FAILED verify:mi"; printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
fi

if [ -n "$PRICER" ]; then
  for G in verify:pricer verify:pricer-pdf; do
    printf "   %-18s " "$G"
    OUT=$(npm run --silent "$G" 2>&1)
    if [ $? -eq 0 ]; then echo "PASS"; else
      echo "FAIL"; FAILED="$FAILED $G"; printf '%s\n' "$OUT" | grep -v 'Warning\|fontkit' | sed 's/^/      /'
    fi
  done
fi

# Offline, deterministic, ZERO API calls. These always run.
[ -z "$WATCHED" ] && GUARDS="" || GUARDS="verify:employer verify:benefits"
for GUARD in $GUARDS; do
  printf "   %-18s " "$GUARD"
  OUT=$(npm run --silent "$GUARD" 2>&1)
  if [ $? -eq 0 ]; then
    echo "PASS"
  else
    echo "FAIL"
    FAILED="$FAILED $GUARD"
    printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
done

# Needs the database + .env.local. Skip cleanly where they are absent (CI, a fresh clone)
# rather than blocking a commit for a reason the committer cannot act on.
if [ -n "$WATCHED" ] && [ -f .env.local ]; then
  printf "   %-18s " "verify:income"
  OUT=$(npm run --silent verify:income 2>&1)
  if [ $? -eq 0 ]; then
    echo "PASS"
  else
    echo "FAIL"
    FAILED="$FAILED verify:income"
    printf '%s\n' "$OUT" | sed 's/^/      /'
  fi
elif [ -n "$WATCHED" ]; then
  echo "   verify:income      SKIPPED (no .env.local — cannot reach the database)"
fi

if [ -n "$FAILED" ]; then
  # SELF-RECORDING. The block writes itself into the lesson ledger, scoped to the files that
  # were actually touched, so the next edit to any of them replays this failure. Nobody decides
  # to write it down; that decision is exactly what kept failing.
  for G in $FAILED; do
    printf '%s\n' "$WATCHED" | while read -r W; do
      [ -z "$W" ] && continue
      SCOPE=$(dirname "$W")
      "$REPO_ROOT/scripts/hooks/lessons.sh" record \
        --scope "$SCOPE" --kind "guard-block" \
        --summary "$G blocked a commit touching $SCOPE — a settled income number would have moved." \
        --detail "Run the guard and read what it names before editing here. If the change is intended: npm run verify:income -- --save" 2>/dev/null || true
    done
  done
  echo ""
  echo "   COMMIT BLOCKED —$FAILED"
  echo ""
  case "$FAILED" in
    *verify:auth*)
      echo "   verify:auth is NEVER a false alarm — a route in apiProtected but missing from"
      echo "   config.matcher is PUBLIC in production. Add the matcher entry named above."
      ;;
  esac
  case "$FAILED" in
    *verify:pricer*)
      echo "   A pricer failure means a manual figure no longer reaches the borrower's bottom"
      echo "   line, or the PDF no longer distinguishes a real quote from an estimate. Both are"
      echo "   how a good-faith estimate becomes a complaint. Read the named check."
      ;;
  esac
  case "$FAILED" in
    *verify:income*|*verify:employer*|*verify:benefits*)
      echo "   An income failure is not automatically a bug: adding a real income document SHOULD"
      echo "   change a file. The point is that it can never happen without somebody seeing it."
      echo "   If every income change listed above is intended, re-baseline and commit again:"
      echo "       npm run verify:income -- --save"
      ;;
  esac
  echo "   To bypass deliberately:  git commit --no-verify"
  echo "──────────────────────────────────────────────────────────────"
  exit 1
fi

echo "   all guards passed"
echo "──────────────────────────────────────────────────────────────"
exit 0
